<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= book.title %></title>
</head>
<body>
  <h1><%= book.title %></h1>

  <p><strong>Описание:</strong> <%= book.description %></p>
  <p><strong>Авторы:</strong> <%= book.authors %></p>
  <p><strong>Избранное:</strong> <%= book.favorite ? 'Да' : 'Нет' %></p>

  <% if (book.fileCover) { %>
    <p>
      <img src="<%= book.fileCover %>" alt="Обложка" style="max-width:200px">
    </p>
  <% } %>

  <% if (book.fileBook) { %>
    <p>
      <a href="/books/<%= book.id %>/download">Скачать книгу</a>
    </p>
  <% } %>

  <!-- Новое: счётчик просмотров -->
  <p><strong>Просмотров:</strong> <%= viewCount %></p>

  <p>
    <a href="/books/<%= book.id %>/update">Редактировать</a> |
    <form action="/books/<%= book.id %>/delete" method="POST" style="display:inline">
      <button type="submit">Удалить</button>
    </form>
  </p>

  <p>
    <a href="/books">← К списку книг</a>
  </p>
</body>
</html>
