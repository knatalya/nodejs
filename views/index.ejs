<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Books Library</title>
</head>
<body>
  <h1>Library</h1>
  <a href="/books/create">Create New Book</a>
  <ul>
    <% books.forEach(book => { %>
      <li><a href="/books/<%= book.id %>"><%= book.title %></a></li>
    <% }) %>
  </ul>
</body>
</html>